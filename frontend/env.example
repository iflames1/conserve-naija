# Shared with the Rust API and Better Auth (same Postgres).
# Local Docker, or the Railway Postgres public/TCP URL in production.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/conserve_naija
BETTER_AUTH_SECRET=cn-dev-better-auth-secret-min-32-chars!
APP_URL=http://localhost:3000
API_URL=http://127.0.0.1:8080
DISABLE_VERIFICATION=1
ADMIN=you@example.com

# Optional Google OAuth. Leave unset to hide nothing — the button still shows;
# configure these to make it succeed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Same key the seeded Lekki device and Wokwi sketch use.
DEMO_DEVICE_API_KEY=cn-dev-lekki-device-key
