# Local: docker compose up -d postgres
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/conserve_naija
#
# Production (Railway Docker Postgres, private hostname):
# DATABASE_URL=postgres://USER:PASSWORD@<postgres-service>.railway.internal:5432/conserve_naija
#
# SQL in ./migrations runs automatically on `cargo run`.
# Optional: cargo migrate / cargo migrate-info (needs sqlx-cli).
# Production image sets MIGRATIONS_DIR=/app/migrations.

APP_URL=http://localhost:3000
INTERNAL_API_SECRET=cn-dev-internal
ADMIN=you@example.com
CN_TEST_AUTH=0
# Local listen. Railway injects PORT at runtime — do not bake PORT into the image.
HOST=0.0.0.0
PORT=8080
